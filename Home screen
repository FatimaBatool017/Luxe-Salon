}

/// Floating glass navigation bar with a raised centre Book button.
class _GlassNav extends StatelessWidget {
  final int index;
  final ValueChanged<int> onTap;
  final VoidCallback onBook;
  const _GlassNav({required this.index, required this.onTap, required this.onBook});

  @override
  Widget build(BuildContext context) {
    final dark = Theme.of(context).brightness == Brightness.dark;

    Widget item(IconData icon, String label, int i) {
      final on = index == i;
      final c = on ? AppColors.roseGold : (dark ? AppColors.blush : AppColors.plum);
      return GestureDetector(
        behavior: HitTestBehavior.opaque,
        onTap: () => onTap(i),
        child: Column(mainAxisSize: MainAxisSize.min, children: [
          Icon(icon, color: c, size: 24),
          const SizedBox(height: 2),
          Text(label, style: TextStyle(fontSize: 10.5, color: c, fontWeight: on ? FontWeight.w700 : FontWeight.w400)),
        ]),
      );
    }

    return Padding(
      padding: const EdgeInsets.fromLTRB(18, 0, 18, 14),
      child: ClipRRect(
        borderRadius: BorderRadius.circular(34),
        child: BackdropFilter(
          filter: ImageFilter.blur(sigmaX: 18, sigmaY: 18),
          child: Container(
            height: 70,
            decoration: BoxDecoration(
              color: tint(dark ? AppColors.plum : Colors.white, .68),
              borderRadius: BorderRadius.circular(34),
              border: Border.all(color: tint(Colors.white, .5)),
            ),
            child: Row(mainAxisAlignment: MainAxisAlignment.spaceAround, children: [
              item(Icons.home_rounded, 'Home', 0),
              item(Icons.content_cut, 'Services', 1),
              GestureDetector(
                onTap: onBook,
                child: Container(
                  width: 54, height: 54,
                  decoration: BoxDecoration(
                    shape: BoxShape.circle,
                    gradient: const LinearGradient(colors: [AppColors.roseGold, AppColors.gold]),
                    boxShadow: [BoxShadow(color: tint(AppColors.roseGold, .5), blurRadius: 16, offset: const Offset(0, 6))],
                  ),
                  child: const Icon(Icons.event_available, color: Colors.white),
                ),
              ),
              item(Icons.local_offer_outlined, 'Offers', 3),
              item(Icons.person_outline, 'Profile', 4),
            ]),
          ),
        ),
      ),
    );
  }
}
